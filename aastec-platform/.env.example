# AASTEC Digital Platform — environment variables (copy to your host's settings)
PORT=4800
DB_PATH=db/aastec.db
UPLOAD_DIR=./uploads

# Demo data: 1 = seed the demo network and demo accounts, 0 = clean production install
SEED_DEMO=1

# First administrator (used when the database is created)
ADMIN_EMAIL=admin@aastec.demo
ADMIN_PASSWORD=

# Claude for the AI features (optional — an offline assistant is used when unset)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
